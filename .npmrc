# LOAD-BEARING: do not delete these without reading CONTRIBUTING.md.
#
# Hoists @babel/* packages to the root node_modules so React Native's Metro
# bundler can resolve them. Without these, the mobile app fails to bundle
# with cryptic "Cannot find module @babel/..." errors. See the matching
# pnpm.packageExtensions block in package.json.
public-hoist-pattern[]=*@babel/generator*
public-hoist-pattern[]=*@babel/types*
public-hoist-pattern[]=*@babel/parser*
public-hoist-pattern[]=*@babel/traverse*
