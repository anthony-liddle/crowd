{
  "name": "crowd",
  "version": "1.0.0",
  "description": "A location-based ephemeral messaging platform with mobile app and server",
  "private": true,
  "scripts": {
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "dev": "concurrently \"pnpm --filter server dev\" \"pnpm --filter mobile start\"",
    "build": "pnpm -r build",
    "dev:server": "pnpm --filter server dev",
    "dev:mobile": "pnpm --filter mobile start",
    "dev:tools": "pnpm --filter devtools dev",
    "server:view:db": "pnpm --filter server view:db",
    "server:cleanup": "pnpm --filter server cleanup",
    "test": "pnpm -r test",
    "test:coverage": "pnpm -r test:coverage"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "packageExtensions": {
      "@react-native-community/slider": {
        "peerDependencies": {
          "react": "*",
          "react-native": "*"
        }
      },
      "@expo-google-fonts/libre-baskerville": {
        "peerDependencies": {
          "react": "*",
          "expo-font": "*"
        }
      },
      "@expo-google-fonts/inter": {
        "peerDependencies": {
          "react": "*",
          "expo-font": "*"
        }
      },
      "nativewind": {
        "peerDependencies": {
          "react": "*",
          "react-native": "*"
        }
      }
    }
  }
}