{
  "expo": {
    "name": "Crowd",
    "slug": "crowd-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F5F0E4",
      "dark": {
        "backgroundColor": "#14130F"
      }
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "bundleIdentifier": "dev.anthonyliddle.crowd",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "Crowd needs camera access to scan QR codes that let you join crowds in person."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Crowd needs camera access to scan QR codes that let you join crowds in person."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "7f7700b7-f926-4cae-aafc-1f7c0192446e"
      }
    }
  }
}
