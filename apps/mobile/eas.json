{
  "build": {
    "dev-deployed": {
      "distribution": "store",
      "autoIncrement": true,
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://crowd-dev.fly.dev"
      }
    }
  },
  "submit": {
    "dev-deployed": {
      "ios": {
        "appleTeamId": "$APPLE_TEAM_ID",
        "ascAppId": "6766116979",
        "ascApiKeyPath": "./api-key.p8",
        "ascApiKeyId": "$ASC_API_KEY_ID",
        "ascApiKeyIssuerId": "$ASC_API_ISSUER_ID"
      }
    }
  },
  "cli": {
    "appVersionSource": "remote"
  }
}
