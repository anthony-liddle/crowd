# Mobile app (Expo) environment variables
#
# Expo reads variables prefixed with EXPO_PUBLIC_* and exposes them to the
# client bundle. Anything here is shipped to users — never put secrets here.

# API URL for the mobile app to call. Required — the app throws at startup
# if this is missing or has no protocol. The default points at the deployed
# dev backend so a fresh checkout works on a physical device out of the box.
# For a fully-local stack, set this to http://<your-mac-LAN-IP>:8080 — phones
# can't reach `localhost` on your dev machine. Rebuild after changing
# (e.g. `pnpm expo run:ios --device`); EXPO_PUBLIC_* values are baked in at
# build time.
EXPO_PUBLIC_API_URL=https://crowd-dev.fly.dev
