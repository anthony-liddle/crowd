# Mobile app (Expo) environment variables
#
# Expo reads variables prefixed with EXPO_PUBLIC_* and exposes them to the
# client bundle. Anything here is shipped to users — never put secrets here.

# API URL for the mobile app to call.
# Leave unset for local development to use the dynamic localhost detection
# in src/services/api.ts. Set explicitly for production builds (e.g. an
# https URL pointing at the deployed server).
EXPO_PUBLIC_API_URL=http://localhost:8080
