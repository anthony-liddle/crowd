# Mobile app (Expo) environment variables
#
# Expo reads variables prefixed with EXPO_PUBLIC_* and exposes them to the
# client bundle. Anything here is shipped to users — never put secrets here.

# API URL for the mobile app to call. Required — the app throws at startup
# if this is missing or has no protocol. Use https://crowd-dev.fly.dev for
# the dev backend, or http://<your-mac-LAN-IP>:8080 for a local server
# (phones can't reach `localhost` on your dev machine). Rebuild after
# changing — EXPO_PUBLIC_* values are baked in at build time.
EXPO_PUBLIC_API_URL=http://localhost:8080
