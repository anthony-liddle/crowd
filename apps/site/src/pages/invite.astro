---
import Base from '../layouts/Base.astro';

// Where an invite link lands without the app: vercel.json rewrites
// /join/* and /join-token/* here. On an iPhone with Crowd installed, iOS
// opens those links in the app instead, because
// public/.well-known/apple-app-site-association names it.
const title = "You're invited to a crowd · Crowd";
const description =
  'An invite to a crowd on Crowd, where anonymous posts reach the people near you and then disappear.';
---

<Base title={title} description={description}>
  <section class="hero">
    <h1>You're invited to a crowd.</h1>
    <p class="lede">
      This link brings you into a crowd on Crowd. On an iPhone with Crowd
      installed, it opens the app, which shows you the crowd before you join.
    </p>
  </section>

  <section class="block">
    <h2>What's a crowd?</h2>
    <p>
      A <strong>crowd</strong> is a trusted, invite-only group. It lasts up to
      24 hours, and everything posted inside it disappears with it. There are no
      accounts and no profiles.
    </p>
  </section>

  <section class="block">
    <h2>Invites don't last</h2>
    <p>
      An invite ends when its crowd does, and a code shown in person works once,
      for 5 minutes. If this one has run out, ask the person who invited you for
      a new one.
    </p>
  </section>

  <section class="cta">
    <p class="cta-note">Crowd isn't in the App Store yet.</p>
    <p class="cta-sub">
      In the meantime, <a href="/">read how Crowd works</a>.
    </p>
  </section>
</Base>

<style>
  .hero {
    margin-bottom: 3.5rem;
  }

  .hero h1 {
    margin: 0 0 1.25rem;
    font-size: clamp(2.25rem, 6vw, 3rem);
  }

  .lede {
    margin: 0;
    font-size: 1.125rem;
    color: var(--ink-2);
    max-width: 34rem;
  }

  .block {
    padding-block: 1.75rem;
    border-top: 1px solid var(--rule);
  }

  .block h2 {
    margin: 0 0 0.5rem;
    font-size: 1.25rem;
  }

  .block p {
    margin: 0;
    color: var(--ink-2);
    max-width: 34rem;
  }

  strong {
    font-weight: 500;
    color: var(--ink);
  }

  .cta {
    margin-top: 2.75rem;
    padding: 1.5rem;
    border: 1px solid var(--rule);
    border-radius: 0.625rem;
  }

  .cta-note {
    margin: 0 0 0.375rem;
    font-family: 'Libre Baskerville', Georgia, serif;
    font-size: 1.0625rem;
    color: var(--ink);
  }

  .cta-sub {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--dust);
  }
</style>
