# Server (Fastify) environment variables.
#
# Copy to .env for local development. Defaults assume the docker-compose stack
# from the repo root (pnpm dev:up) — adjust DATABASE_URL if you're running
# Postgres elsewhere.

# PostgreSQL connection string. Used by both drizzle-kit and the runtime pool.
# When the server runs inside docker-compose, this is overridden by the
# compose service env to point at the `db` service hostname.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/monorepo_db

# HTTP listen port.
PORT=8080

# HTTP listen host. 0.0.0.0 is required inside containers; fine for host dev.
HOST=0.0.0.0

# CORS allowlist. '*' is fine for local dev; production sets this to the
# deployed mobile/devtools origins.
CORS_ORIGIN=*
