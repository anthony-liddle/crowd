{
  "name": "@app/server",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx --conditions=development watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/index.js",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "view:db": "drizzle-kit studio",
    "cleanup": "tsx --conditions=development src/scripts/cleanup-expired.ts",
    "seed": "tsx --conditions=development src/scripts/seed.ts",
    "test": "bash scripts/test-wrapper.sh",
    "test:watch": "vitest",
    "test:coverage": "bash scripts/test-wrapper.sh --coverage",
    "test:ui": "vitest --ui",
    "test:integration": "vitest run __tests__/integration"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/rate-limit": "^10.3.0",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.8.5",
    "pg": "^8.21.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.14.0",
    "@types/node": "^25.9.1",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^4.1.7",
    "@vitest/ui": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "pino": "^10.3.1",
    "testcontainers": "^11.14.0",
    "tsx": "^4.22.3",
    "typescript": "^5.9.3",
    "uuid": "^14.0.0",
    "vitest": "^4.1.7"
  }
}
