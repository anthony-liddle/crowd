{
  "name": "@app/server",
  "version": "1.0.0",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "view:db": "drizzle-kit studio",
    "cleanup": "tsx src/scripts/cleanup-expired.ts",
    "test": "bash scripts/test-wrapper.sh",
    "test:watch": "vitest",
    "test:coverage": "bash scripts/test-wrapper.sh --coverage",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/db tests/api",
    "test:api": "vitest run tests/api",
    "test:db": "vitest run tests/db"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@repo/shared": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.8.3",
    "pg": "^8.20.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^11.12.0",
    "@types/node": "^20.12.7",
    "@types/pg": "^8.18.0",
    "@types/uuid": "^9.0.8",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "drizzle-kit": "^0.31.9",
    "pino": "^10.3.1",
    "testcontainers": "^11.12.0",
    "tsx": "^4.7.3",
    "typescript": "^5.9.3",
    "uuid": "^9.0.1",
    "vitest": "^4.0.18"
  }
}
